{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tender-dataset-1.0.0.json",
  "title": "TenderDataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "queryMode",
    "fetchedAt",
    "recordCount",
    "sha256",
    "tenders"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "source": { "const": "https://web.pcc.gov.tw/" },
    "queryMode": { "const": "isNow" },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "recordCount": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tenders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "method",
          "budget",
          "announcedDate",
          "deadlineDate",
          "link"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "name": { "type": "string", "minLength": 1, "maxLength": 500 },
          "method": { "type": "string", "minLength": 1, "maxLength": 160 },
          "budget": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "announcedDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "deadlineDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "link": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://web\\.pcc\\.gov\\.tw/prkms/"
          }
        }
      }
    }
  }
}
