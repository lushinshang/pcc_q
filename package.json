{
  "name": "mod-tender-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "data:sample": "node --import tsx scripts/create-sample-data.ts",
    "fetch:data": "node --import tsx scripts/fetch-tenders.ts",
    "security:dist": "node --import tsx scripts/security/scan-dist.ts",
    "security:repo": "node --import tsx scripts/security/scan-repository.ts",
    "security:history": "go run github.com/zricethezav/gitleaks/v8@v8.30.1 git --no-banner --redact --verbose .",
    "security:workflows": "vitest run tests/security/workflows.test.ts",
    "workflow:lint": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 .github/workflows/ci.yml .github/workflows/codeql.yml .github/workflows/data-and-pages.yml",
    "validate:html": "html-validate dist/index.html",
    "validate:code": "npm run format && npm run lint && npm run typecheck && npm run test:coverage",
    "validate": "npm run validate:code && npm run security:repo && npm run security:workflows && npm run workflow:lint && npm run build && npm run validate:html && npm run security:dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.0.4",
    "cheerio": "1.2.0",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "html-validate": "11.5.6",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
